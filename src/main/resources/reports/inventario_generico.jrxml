    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <property name="com.jaspersoft.studio.unit." value="pixel"/>

    <style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="8" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Titulo" fontName="DejaVu Sans" fontSize="16" isBold="true" forecolor="#F4F7FB"/>
    <style name="Subtitulo" fontName="DejaVu Sans" fontSize="9" forecolor="#C5D0DC"/>
    <style name="Meta" fontName="DejaVu Sans" fontSize="8" forecolor="#A8B6C4"/>
    <style name="ColHeader" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#F4F7FB" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8" forecolor="#1B2430" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="CeldaNumero" style="Celda" hTextAlign="Right"/>
    <style name="Pie" fontName="DejaVu Sans" fontSize="7" forecolor="#6B7785"/>

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="SUBTITULO" class="java.lang.String"/>
    <parameter name="SISTEMA" class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="COLUMNA_EXTRA" class="java.lang.String"/>
    <parameter name="CANTIDAD" class="java.lang.Integer"/>
    <parameter name="FILTRO" class="java.lang.String"/>

    <field name="numero" class="java.lang.Integer"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="subcategoria" class="java.lang.String"/>
    <field name="precio" class="java.lang.String"/>
    <field name="extra" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <variable name="TOTAL_REGISTROS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{numero}]]></variableExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>

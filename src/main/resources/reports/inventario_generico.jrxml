            <textField>
                <reportElement style="Meta" x="540" y="28" width="246" height="14" uuid="9f2c8d10-5a47-4b91-ae33-0c6e1d8b4527"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Generado: " + $P{FECHA_GENERACION}]]></textFieldExpression>
            </textField>
        </band>

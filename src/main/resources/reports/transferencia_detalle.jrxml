                    <reportElement style="Pie" x="0" y="8" width="555" height="12" uuid="fb8601c0-70f5-4764-a130-c9bf340a113c"/>
                    <text><![CDATA[Firmas de los responsables (usuario logueado en cada etapa)]]></text>
                </staticText>
                <staticText>
                    <reportElement style="FirmaTitulo" x="20" y="28" width="240" height="14" uuid="d6399a71-bc66-4a69-a154-5b78b9b3f139"/>
                    <text><![CDATA[ENTREGA — SECTOR ORIGEN]]></text>
                </staticText>
                <line>
                    <reportElement x="40" y="62" width="200" height="1" forecolor="#1B2430" uuid="a2d9a911-c831-43d9-bcb6-963113181499"/>
                </line>
                <textField>
                    <reportElement style="FirmaNombre" x="20" y="66" width="240" height="14" uuid="e17372e0-c972-4707-9af1-e989a53b84c1"/>
                    <textFieldExpression><![CDATA[$F{firmaEntrega} == null || $F{firmaEntrega}.isBlank() ? "Aclaración" : $F{firmaEntrega}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="FirmaHint" x="20" y="80" width="240" height="12" uuid="005b8424-d782-493e-9eb1-55d801b33674"/>
                    <text><![CDATA[Firma y aclaración]]></text>
                </staticText>
                <staticText>
                    <reportElement style="FirmaTitulo" x="295" y="28" width="240" height="14" uuid="c3cbb12b-4bdf-476c-8535-378dfe16e25e"/>
                    <text><![CDATA[RECEPCIÓN — SECTOR DESTINO]]></text>
                </staticText>
                <line>
                    <reportElement x="315" y="62" width="200" height="1" forecolor="#1B2430" uuid="66f97184-d760-458f-bd0e-9132f247606d"/>
                </line>
                <textField>
                    <reportElement style="FirmaNombre" x="295" y="66" width="240" height="14" uuid="2b6510ca-a0f1-4545-b2d6-33ff4d64f66e"/>
                    <textFieldExpression><![CDATA[$F{firmaRecepcion} == null || $F{firmaRecepcion}.isBlank() ? "Aclaración" : $F{firmaRecepcion}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="FirmaHint" x="295" y="80" width="240" height="12" uuid="dc035ad1-220d-4225-83ff-9c58e5874625"/>
                    <text><![CDATA[Firma y aclaración]]></text>
                </staticText>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="58" splitType="Stretch">
            <rectangle radius="4">
                <reportElement x="0" y="0" width="555" height="54" backcolor="#1A2332" forecolor="#1A2332" uuid="9e5bd4cc-3ffb-417a-a6cf-6ae129b4d0b0"/>

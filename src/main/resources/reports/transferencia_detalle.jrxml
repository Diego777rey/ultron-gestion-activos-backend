<?xml version="1.0" encoding="UTF-8"?>
<!--
  Comprobante de transferencia. Una página (o grupo) por transferencia.
  Incluye bloques de firma para entrega (origen) y recepción (destino).
  Campos alimentados por ReporteTransferenciaDetalleFila.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transferencia_detalle"
              pageWidth="595"
              pageHeight="842"
              orientation="Portrait"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="18"
              bottomMargin="18"
              whenNoDataType="AllSectionsNoDetail"
              isIgnorePagination="false"
              uuid="c429de4f-608e-4f9f-ab07-43b433e81448">

    <style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="8" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Titulo" fontName="DejaVu Sans" fontSize="15" isBold="true" forecolor="#F4F7FB"/>
    <style name="Subtitulo" fontName="DejaVu Sans" fontSize="8" forecolor="#C5D0DC"/>
    <style name="Meta" fontName="DejaVu Sans" fontSize="8" forecolor="#A8B6C4"/>
    <style name="GrupoTitulo" fontName="DejaVu Sans" fontSize="11" isBold="true" forecolor="#F4F7FB"/>
    <style name="GrupoMeta" fontName="DejaVu Sans" fontSize="8" forecolor="#C5D0DC"/>
    <style name="Encabezado" fontName="DejaVu Sans" fontSize="8" forecolor="#1B2430"/>
    <style name="ColHeader" fontName="DejaVu Sans" fontSize="7" isBold="true" forecolor="#F4F7FB" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8" forecolor="#1B2430" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="CeldaNumero" style="Celda" hTextAlign="Right"/>
    <style name="Pie" fontName="DejaVu Sans" fontSize="7" forecolor="#6B7785"/>
    <style name="FirmaTitulo" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#1B2430" hTextAlign="Center"/>
    <style name="FirmaNombre" fontName="DejaVu Sans" fontSize="8" forecolor="#1B2430" hTextAlign="Center"/>
    <style name="FirmaHint" fontName="DejaVu Sans" fontSize="7" forecolor="#6B7785" hTextAlign="Center"/>

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="SUBTITULO" class="java.lang.String"/>
    <parameter name="SISTEMA" class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="COLUMNA_EXTRA" class="java.lang.String"/>
    <parameter name="CANTIDAD" class="java.lang.Integer"/>
    <parameter name="FILTRO" class="java.lang.String"/>

    <field name="numero" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="encabezado" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="nombreLinea" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.String"/>
    <field name="estadoLinea" class="java.lang.String"/>
    <field name="firmaEntrega" class="java.lang.String"/>
    <field name="firmaRecepcion" class="java.lang.String"/>

    <group name="Transferencia" isStartNewPage="true">
        <groupExpression><![CDATA[$F{numero}]]></groupExpression>
        <groupHeader>
            <band height="118" splitType="Stretch">
                <rectangle radius="3">
                    <reportElement x="0" y="0" width="555" height="28" backcolor="#1A2332" forecolor="#1A2332" uuid="a03b93c5-17ac-4156-8fa9-d9edc2691e4a"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="GrupoTitulo" x="10" y="4" width="260" height="20" uuid="3ba29e34-b10d-4397-8ec9-1ecb69d9c797"/>
                    <textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="GrupoMeta" x="270" y="4" width="140" height="20" uuid="dedee043-d435-429f-8a17-c644e7523aad"/>
                    <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="GrupoMeta" x="410" y="4" width="135" height="20" uuid="21ec49d7-e5ca-4d72-b21e-6ec5ececd643"/>

                    <graphicElement>
                        <pen lineWidth="0.4" lineColor="#D5DEE8"/>
                    </graphicElement>
                </rectangle>
                <textField textAdjust="StretchHeight">
                    <reportElement style="Encabezado" x="8" y="36" width="539" height="54" positionType="Float" uuid="c9f2cdde-fdfa-4603-8b68-584cb31dc665"/>
                    <textElement markup="none">
                        <paragraph lineSpacing="Single"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{encabezado}]]></textFieldExpression>
                </textField>
                <rectangle>
                    <reportElement x="0" y="98" width="555" height="16" positionType="Float" backcolor="#2B3A4A" forecolor="#2B3A4A" uuid="b523e4af-e0c5-4895-a735-5f08247e3de9"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <staticText>
                    <reportElement style="ColHeader" x="8" y="98" width="110" height="16" positionType="Float" uuid="ddcea845-4c74-4983-8fee-d1efb73958bc"/>
                    <text><![CDATA[CÓDIGO]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="122" y="98" width="260" height="16" positionType="Float" uuid="d017425b-cab3-4000-b912-13f432f9ccc6"/>
                    <text><![CDATA[PRODUCTO]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="386" y="98" width="60" height="16" positionType="Float" uuid="2d090896-b60d-4096-9e8b-cafd1ecbdd18"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[CANT.]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="450" y="98" width="97" height="16" positionType="Float" uuid="762af909-191e-4b09-a097-570a7c16317a"/>
                    <text><![CDATA[ESTADO]]></text>
                </staticText>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="108">

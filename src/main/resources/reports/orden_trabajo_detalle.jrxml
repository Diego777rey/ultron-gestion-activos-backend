<?xml version="1.0" encoding="UTF-8"?>
<!--
  Detalle de orden de trabajo. Una página (o grupo) por OT.
  Campos alimentados por ReporteOtDetalleFila.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="orden_trabajo_detalle"
              pageWidth="595"
              pageHeight="842"
              orientation="Portrait"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="18"
              bottomMargin="18"
              whenNoDataType="AllSectionsNoDetail"
              isIgnorePagination="false"
              uuid="a1c4e8b2-5d70-4f19-9e33-2b6d0c8a41f0">

    <style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="8" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Titulo" fontName="DejaVu Sans" fontSize="13" isBold="true" forecolor="#1A1A1A"/>
    <style name="Subtitulo" fontName="DejaVu Sans" fontSize="8" forecolor="#333333"/>
    <style name="Meta" fontName="DejaVu Sans" fontSize="8" forecolor="#333333"/>
    <style name="GrupoTitulo" fontName="DejaVu Sans" fontSize="11" isBold="true" forecolor="#1A1A1A"/>
    <style name="GrupoMeta" fontName="DejaVu Sans" fontSize="8" forecolor="#333333"/>
    <style name="Encabezado" fontName="DejaVu Sans" fontSize="8" forecolor="#1A1A1A"/>
    <style name="ColHeader" fontName="DejaVu Sans" fontSize="7" isBold="true" forecolor="#1A1A1A" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8" forecolor="#1A1A1A" hTextAlign="Left" vTextAlign="Middle"/>
    <style name="CeldaNumero" style="Celda" hTextAlign="Right"/>
    <style name="Pie" fontName="DejaVu Sans" fontSize="7" forecolor="#4A5560"/>

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="SUBTITULO" class="java.lang.String"/>
    <parameter name="SISTEMA" class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="COLUMNA_EXTRA" class="java.lang.String"/>
    <parameter name="CANTIDAD" class="java.lang.Integer"/>
    <parameter name="FILTRO" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="numeroOrden" class="java.lang.String"/>
    <field name="etapa" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="presupuesto" class="java.lang.String"/>
    <field name="encabezado" class="java.lang.String"/>
    <field name="tipoLinea" class="java.lang.String"/>
    <field name="nombreLinea" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.String"/>
    <field name="precio" class="java.lang.String"/>
    <field name="subtotal" class="java.lang.String"/>

    <group name="Orden" isStartNewPage="true">
        <groupExpression><![CDATA[$F{numeroOrden}]]></groupExpression>
        <groupHeader>
            <band height="118" splitType="Stretch">
                <rectangle>
                    <reportElement x="0" y="0" width="555" height="28" backcolor="#F3F3F3" forecolor="#1A1A1A" uuid="b2d0e7c1-3a61-4e2f-80aa-1c6d9b4e8f21"/>
                    <graphicElement>
                        <pen lineWidth="0.6" lineColor="#1A1A1A"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="GrupoTitulo" x="10" y="4" width="220" height="20" uuid="c3e1f8d2-4b72-4f30-91bb-2d7e0c5f9a32"/>
                    <textFieldExpression><![CDATA["OT " + $F{numeroOrden}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="GrupoMeta" x="240" y="4" width="160" height="20" uuid="d4f2a9e3-5c83-5041-a2cc-3e8f1d60ab43"/>
                    <textFieldExpression><![CDATA[$F{etapa}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="GrupoMeta" x="400" y="4" width="145" height="20" uuid="e5a3b0f4-6d94-6152-b3dd-4f902e71bc54"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
                </textField>
                <rectangle>
                    <reportElement x="0" y="32" width="555" height="62" stretchType="RelativeToTallestObject" backcolor="#FFFFFF" forecolor="#8A8A8A" uuid="f6b4c105-7ea5-7263-c4ee-50a13f82cd65"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#8A8A8A"/>
                    </graphicElement>
                </rectangle>
                <textField textAdjust="StretchHeight">
                    <reportElement style="Encabezado" x="8" y="36" width="539" height="54" positionType="Float" uuid="07c5d216-8fb6-8374-d5ff-61b24093de76"/>
                    <textElement markup="none">
                        <paragraph lineSpacing="Single"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{encabezado}]]></textFieldExpression>
                </textField>
                <rectangle>
                    <reportElement x="0" y="98" width="555" height="16" positionType="Float" backcolor="#E6E6E6" forecolor="#1A1A1A" uuid="18d6e327-90c7-9485-e600-72c351a4ef87"/>
                    <graphicElement>
                        <pen lineWidth="0.6" lineColor="#1A1A1A"/>
                    </graphicElement>
                </rectangle>
                <staticText>
                    <reportElement style="ColHeader" x="8" y="98" width="70" height="16" positionType="Float" uuid="29e7f438-a1d8-a596-f711-83d462b5f098"/>
                    <text><![CDATA[TIPO]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="82" y="98" width="233" height="16" positionType="Float" uuid="3af80549-b2e9-b6a7-0822-94e573c601a9"/>
                    <text><![CDATA[ÍTEM]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="319" y="98" width="60" height="16" positionType="Float" uuid="4b09165a-c3fa-c7b8-1933-a5f684d712ba"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[CANT.]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="383" y="98" width="80" height="16" positionType="Float" uuid="5c1a276b-d40b-d8c9-2a44-b60795e823cb"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[PRECIO]]></text>
                </staticText>
                <staticText>
                    <reportElement style="ColHeader" x="467" y="98" width="80" height="16" positionType="Float" uuid="6d2b387c-e51c-e9da-3b55-c718a6f934dc"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[SUBTOTAL]]></text>
                </staticText>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="22">
                <staticText>
                    <reportElement style="Celda" x="280" y="4" width="180" height="16" uuid="8f4d5a9e-073e-0bfc-5d77-e93ac81b56fe"/>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Total]]></text>
                </staticText>
                <textField>
                    <reportElement style="CeldaNumero" x="467" y="4" width="80" height="16" uuid="905e6baf-184f-1c0d-6e88-fa4bd92c670f"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{presupuesto}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <pageHeader>
        <band height="112" splitType="Stretch">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="92" height="100" uuid="a16f7cb0-2950-2d1e-7f99-0b5cea3d7810"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Titulo" x="104" y="24" width="451" height="20" uuid="c3819ed2-4b72-4f30-91bb-2d7e0c5f9a32"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Meta" x="118" y="62" width="62" height="14" uuid="b2708dc1-3a61-3e2f-80aa-1c6dfb4e8921"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Generado]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Meta" x="182" y="62" width="130" height="14" uuid="e5a3b014-6d94-6152-b3dd-4f902e71bc54"/>
                <textFieldExpression><![CDATA[$P{FECHA_GENERACION}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Meta" x="328" y="62" width="54" height="14" uuid="f6b4c125-7ea5-7263-c4ee-50a13f82cd66"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Meta" x="384" y="62" width="171" height="14" uuid="f6b4c125-7ea5-7263-c4ee-50a13f82cd67"/>
                <textFieldExpression><![CDATA[$P{USUARIO} == null || $P{USUARIO}.isBlank() ? "—" : $P{USUARIO}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <textField textAdjust="StretchHeight">
                <reportElement style="Celda" x="8" y="1" width="70" height="16" uuid="07c5d236-8fb6-8374-d5ff-61b24093de76"/>
                <textFieldExpression><![CDATA[$F{tipoLinea}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Celda" x="82" y="1" width="233" height="16" uuid="18d6e347-90c7-9485-e600-72c351a4ef87"/>
                <textFieldExpression><![CDATA[$F{nombreLinea}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="CeldaNumero" x="319" y="1" width="60" height="16" uuid="29e7f458-a1d8-a596-f711-83d462b5f098"/>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="CeldaNumero" x="383" y="1" width="80" height="16" uuid="3af80569-b2e9-b6a7-0822-94e573c601a9"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="CeldaNumero" x="467" y="1" width="80" height="16" uuid="4b09167a-c3fa-c7b8-1933-a5f684d712ba"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="17" width="555" height="1" positionType="FixRelativeToBottom" forecolor="#E2E8F0" uuid="5c1a278b-d40b-d8c9-2a44-b60795e823cb"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Pie" x="0" y="2" width="250" height="14" uuid="6d2b389c-e51c-e9da-3b55-c718a6f934dc"/>
                <textFieldExpression><![CDATA["CH Service"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Pie" x="340" y="2" width="170" height="14" uuid="7e3c49ad-f62d-faeb-4c66-d829b70a45ed"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Pie" x="510" y="2" width="45" height="14" uuid="7e3c49ad-f62d-faeb-4c66-d829b70a45ee"/>
                <textFieldExpression><![CDATA[String.valueOf($V{PAGE_NUMBER})]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

# =============================================================
# Tipos de datos para Compras
# =============================================================

type CompraOutput {
    id_compra: ID!
    id_proveedor: ID!
    proveedor_nombre: String
    id_vendedor: ID
    vendedor_nombre: String
    id_sector: ID
    sector_nombre: String
    numero_factura: String
    timbrado: String
    fecha_factura: String
    fecha_compra: String!
    forma_pago: String!
    moneda: String!
    cotizacion: Float!
    subtotal: Float!
    total_iva: Float!
    total: Float!
    estado: String!
    observaciones: String
    fecha_registro: String
    fecha_ultima_modificacion: String
    items: [ItemCompraOutput!]
}

type ItemCompraOutput {
    id_item_compra: ID!
    id_compra: ID!
    id_producto: ID!
    producto_nombre: String
    producto_codigo: String
    cantidad: Float!
    precio_costo: Float!
    subtotal: Float!
    tipo_iva: String
    iva: Float
    fecha_vencimiento: String
    lote: String
    observaciones: String
    fecha_registro: String
}

type ProductoProveedorOutput {
    id_producto_proveedor: ID!
    id_producto: ID!
    producto_nombre: String
    producto_codigo: String
    id_proveedor: ID!
    proveedor_nombre: String
    precio_ultima_compra: Float
    fecha_ultima_compra: String
    observaciones: String
    activo: Boolean!
    fecha_registro: String
}

type ProductoProveedorPageResponse {
    content: [ProductoProveedorOutput!]!
    pageInfo: PageInfo!
}

# =============================================================
# Inputs para Compras
# =============================================================

input CompraInput {
    idProveedor: ID!
    idVendedor: ID
    idSector: ID
    numeroFactura: String
    timbrado: String
    fechaFactura: Date
    formaPago: String!
    moneda: String
    cotizacion: Float
    estado: String
    observaciones: String
    items: [ItemCompraInput!]
}

input ItemCompraInput {
    idProducto: ID!
    cantidad: Float!
    precioCosto: Float!
    tipoIva: String
    fechaVencimiento: Date
    lote: String
    observaciones: String
}

# =============================================================
# Queries
# =============================================================

extend type Query {
    # Compras
    compras: [CompraOutput!]!
    compra(id: ID!): CompraOutput
    comprasPorProveedor(idProveedor: ID!): [CompraOutput!]!
    comprasPorEstado(estado: String!): [CompraOutput!]!
    comprasPorRangoFecha(fechaInicio: String!, fechaFin: String!): [CompraOutput!]!
    
    # Productos por proveedor
    productosDeProveedor(idProveedor: ID!): [ProductoProveedorOutput!]!
    productosDeProveedorPaginado(idProveedor: ID!, page: Int!, size: Int!, filter: String): ProductoProveedorPageResponse!
    proveedoresDeProducto(idProducto: ID!): [ProductoProveedorOutput!]!
    historialCompraProducto(idProducto: ID!, idProveedor: ID!): [ItemCompraOutput!]!
}

# =============================================================
# Mutations
# =============================================================

extend type Mutation {
    registrarCompra(input: CompraInput!): CompraOutput!
    actualizarCompra(id: ID!, input: CompraInput!): CompraOutput!
    cambiarEstadoCompra(id: ID!, estado: String!): CompraOutput!
    eliminarCompra(id: ID!): Boolean!

    # Productos por proveedor
    asociarProductoProveedor(idProducto: ID!, idProveedor: ID!): ProductoProveedorOutput!
    desasociarProductoProveedor(idProducto: ID!, idProveedor: ID!): Boolean!
}

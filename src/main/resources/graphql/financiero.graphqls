# =============================================================
# Schema Financiero — Cajas, Maletines, Sesiones y Ventas POS
# =============================================================

type CajaOutput {
    id_caja: ID
    nombre: String
    saldoActual: BigDecimal
    idEmpresa: ID
    responsable: PersonaOutput
    sector: SectorOutput
    activa: Boolean
}

type CajaPageResponse {
    content: [CajaOutput!]!
    pageInfo: PageInfo!
}

input CajaInput {
    nombre: String!
    saldoActual: BigDecimal
    idEmpresa: ID
    idResponsable: ID
    idSector: ID!
    activa: Boolean
}

type MaletinOutput {
    id_maletin: ID
    nombre: String
    abierto: Boolean
    sector: SectorOutput
    responsable: PersonaOutput
    activo: Boolean
    idCajaActual: ID
    ultimoMovimiento: String
    ultimoResponsable: PersonaOutput
}

type MaletinPageResponse {
    content: [MaletinOutput!]!
    pageInfo: PageInfo!
}

input MaletinInput {
    nombre: String!
    idSector: ID!
    idResponsable: ID
    activo: Boolean
}

type ConteoDenominacionOutput {
    id_conteo: ID
    tipo: String
    moneda: String
    valorDenominacion: BigDecimal
    cantidad: Int
}

input ConteoDenominacionInput {
    moneda: String!
    valorDenominacion: BigDecimal!
    cantidad: Int!
}

type SesionCajaOutput {
    id_sesion_caja: ID
    caja: CajaOutput
    maletin: MaletinOutput
    persona: PersonaOutput
    estado: String
    montoInicialPyg: BigDecimal
    montoInicialUsd: BigDecimal
    montoInicialBrl: BigDecimal
    montoFinalPyg: BigDecimal
    montoFinalUsd: BigDecimal
    montoFinalBrl: BigDecimal
    # Apertura menos el último cierre del mismo maletín (0 si el maletín no tenía cierres).
    diferenciaPyg: BigDecimal
    diferenciaUsd: BigDecimal
    diferenciaBrl: BigDecimal
    # Efectivo que debería haber al cerrar: apertura + cobros en efectivo - vueltos - retiros.
    esperadoCierrePyg: BigDecimal
    esperadoCierreUsd: BigDecimal
    esperadoCierreBrl: BigDecimal
    # Contado al cierre menos esperado: negativo es faltante, positivo sobrante.
    diferenciaArqueoPyg: BigDecimal
    diferenciaArqueoUsd: BigDecimal
    diferenciaArqueoBrl: BigDecimal
    totalVentasPyg: BigDecimal
    fechaApertura: String
    fechaCierre: String
    conteos: [ConteoDenominacionOutput!]
    # Cierre con el que se comparó la apertura; null si el maletín no tenía cierres.
    idSesionAnterior: ID
    fechaCierreAnterior: String
    montoCierreAnteriorPyg: BigDecimal
    montoCierreAnteriorUsd: BigDecimal
    montoCierreAnteriorBrl: BigDecimal
}

type TicketConteoLinea {
    valor: BigDecimal!
    cantidad: Int!
    subtotal: BigDecimal!
}

type TicketConteoMoneda {
    moneda: String!
    # Solo denominaciones con cantidad, de menor a mayor.
    lineas: [TicketConteoLinea!]!
    total: BigDecimal!
}

type TicketVentasFormaPago {
    formaPago: String!
    cantidad: Int!
    # En guaraníes.
    total: BigDecimal!
}

# Arqueo de una moneda: esperado = apertura + cobrosEfectivo - vueltos - retiros.
type ArqueoMonedaOutput {
    moneda: String!
    apertura: BigDecimal!
    cobrosEfectivo: BigDecimal!
    vueltos: BigDecimal!
    retiros: BigDecimal!
    esperado: BigDecimal!
    # Null mientras la sesión está abierta.
    contado: BigDecimal
    # Contado menos esperado (negativo: faltante). Null mientras la sesión está abierta.
    diferencia: BigDecimal
}

type RetiroCajaOutput {
    id_retiro_caja: ID
    idSesionCaja: ID
    moneda: String
    monto: BigDecimal
    observacion: String
    fecha: String
    idUsuarioResponsable: ID
    responsableUsuario: String
    responsableNombre: String
    registradoPor: String
}

input RetiroCajaInput {
    idSesionCaja: ID!
    # PYG, BRL o USD.
    moneda: String!
    monto: BigDecimal!
    observacion: String!
    idUsuarioResponsable: ID!
}

type TicketRetiro {
    # dd/MM HH:mm
    fecha: String
    moneda: String!
    monto: BigDecimal!
    responsable: String
    observacion: String
}

type TicketDiferenciaMoneda {
    moneda: String!
    # Null si no hay cierre anterior.
    cierreAnterior: BigDecimal
    apertura: BigDecimal!
    # Apertura menos cierre anterior.
    diferencia: BigDecimal!
}

# Datos del ticket térmico de cierre de caja. Las fechas vienen como dd/MM/yyyy HH:mm.
type TicketCierreCajaOutput {
    idSesionCaja: ID!
    caja: String
    maletin: String
    cajero: String
    fechaApertura: String
    fechaCierre: String
    conteoApertura: [TicketConteoMoneda!]!
    conteoCierre: [TicketConteoMoneda!]!
    cantidadVentas: Int!
    totalVentasPyg: BigDecimal!
    ventasPorFormaPago: [TicketVentasFormaPago!]!
    retiros: [TicketRetiro!]!
    arqueo: [ArqueoMonedaOutput!]!
    idSesionAnterior: ID
    fechaCierreAnterior: String
    diferencias: [TicketDiferenciaMoneda!]!
}

type SesionCajaPageResponse {
    content: [SesionCajaOutput!]!
    pageInfo: PageInfo!
}

input AbrirCajaInput {
    idCaja: ID!
    idMaletin: ID!
    idPersona: ID
    conteos: [ConteoDenominacionInput!]!
}

input CerrarCajaInput {
    idSesionCaja: ID!
    conteos: [ConteoDenominacionInput!]!
}

type DetalleVentaOutput {
    id_detalle_venta: ID
    idProducto: ID
    idPresentacion: ID
    presentacionDescripcion: String
    idOrdenTrabajo: ID
    idServicio: ID
    productoNombre: String
    cantidad: BigDecimal
    precioUnitario: BigDecimal
    subtotal: BigDecimal
}

type VentaOutput {
    id_venta: ID
    numero: String
    fecha: String
    idSesionCaja: ID
    idCliente: ID
    clienteNombre: String
    subtotal: BigDecimal
    descuento: BigDecimal
    total: BigDecimal
    estado: String
    formaPago: String
    moneda: String
    montoMonedaOriginal: BigDecimal
    # Efectivo entregado por el cliente, en la moneda de la venta (`moneda`).
    montoRecibido: BigDecimal
    # Equivalente en guaraníes del monto recibido.
    montoRecibidoPyg: BigDecimal
    # Moneda en la que se entregó el vuelto.
    monedaVuelto: String
    # Vuelto entregado, en monedaVuelto.
    vuelto: BigDecimal
    # Vuelto en guaraníes.
    vueltoPyg: BigDecimal
    detalles: [DetalleVentaOutput!]
}

type VentaConFacturaOutput {
    venta: VentaOutput!
    factura: FacturaOutput!
}

type VentaPageResponse {
    content: [VentaOutput!]!
    pageInfo: PageInfo!
}

input DetalleVentaInput {
    idProducto: ID
    idPresentacion: ID
    idOrdenTrabajo: ID
    idServicio: ID
    descripcion: String
    cantidad: BigDecimal!
    precioUnitario: BigDecimal
}

input VentaInput {
    idSesionCaja: ID!
    idCliente: ID
    descuento: BigDecimal
    formaPago: String
    moneda: String
    montoMonedaOriginal: BigDecimal
    # Efectivo entregado por el cliente, en la moneda de la venta (`moneda`, PYG por defecto).
    # Solo aplica a EFECTIVO; el vuelto lo calcula el backend.
    montoRecibido: BigDecimal
    # Moneda en la que el cajero entrega el vuelto (PYG por defecto).
    monedaVuelto: String
    detalles: [DetalleVentaInput!]!
}

extend type Query {
    listarCajas: [CajaOutput!]!
    listarCajasDisponibles: [CajaOutput!]!
    listarCajasPaginado(page: Int!, size: Int!, filter: String): CajaPageResponse!
    buscarCajaPorId(id: ID!): CajaOutput

    listarMaletines: [MaletinOutput!]!
    listarMaletinesDisponibles(idSector: ID): [MaletinOutput!]!
    listarMaletinesPaginado(page: Int!, size: Int!, filter: String): MaletinPageResponse!
    buscarMaletinPorId(id: ID!): MaletinOutput

    sesionCajaAbierta(idCaja: ID): SesionCajaOutput
    buscarSesionCajaPorId(id: ID!): SesionCajaOutput
    # Solo para sesiones cerradas.
    ticketCierreCaja(idSesionCaja: ID!): TicketCierreCajaOutput!
    # Efectivo esperado por moneda; con la sesión cerrada incluye contado y diferencia.
    arqueoSesionCaja(idSesionCaja: ID!): [ArqueoMonedaOutput!]!
    listarRetirosPorSesion(idSesionCaja: ID!): [RetiroCajaOutput!]!
    listarSesionesCajaPaginado(
        page: Int!,
        size: Int!,
        filter: String,
        idCaja: ID,
        estado: String,
        fechaDesde: String,
        fechaHasta: String
    ): SesionCajaPageResponse!
    # Cierres del usuario logueado, el más reciente primero. Fechas yyyy-MM-dd sobre la fecha de cierre.
    listarMisSesionesCajaCerradas(
        page: Int!,
        size: Int!,
        fechaDesde: String,
        fechaHasta: String
    ): SesionCajaPageResponse!

    listarVentas: [VentaOutput!]!
    listarVentasPaginado(page: Int!, size: Int!, filter: String, idSesionCaja: ID): VentaPageResponse!
    listarVentasPorSesion(idSesionCaja: ID!): [VentaOutput!]!
    buscarVentaPorId(id: ID!): VentaOutput
}

type CotizacionOutput {
    id_cotizacion: ID
    moneda: String
    valor: BigDecimal
    fechaActualizacion: String
    activa: Boolean
}

type CotizacionPageResponse {
    content: [CotizacionOutput!]!
    pageInfo: PageInfo!
}

input CotizacionInput {
    moneda: String!
    valor: BigDecimal!
    activa: Boolean
}

type MontoCotizado {
    moneda: String!
    valorCotizacion: BigDecimal
    monto: BigDecimal!
}

# Billete o moneda que forma parte del vuelto.
type DenominacionVuelto {
    valor: BigDecimal!
    # BILLETE o MONEDA
    tipo: String!
    cantidad: Int!
    subtotal: BigDecimal!
}

# Vuelto de un cobro en efectivo. El cliente puede pagar en PYG o en una moneda con
# cotización activa (USD, BRL...) y el cajero puede devolver en cualquier otra.
type VueltoOutput {
    totalPyg: BigDecimal!

    # ---- Lo que entrega el cliente ----
    monedaRecibida: String!
    # Guaraníes por unidad de la moneda recibida. Null cuando es PYG.
    cotizacionRecibida: BigDecimal
    # Total a cobrar expresado en la moneda recibida.
    totalMonedaRecibida: BigDecimal!
    # Lo que entregó el cliente, en la moneda recibida.
    montoRecibido: BigDecimal
    # Equivalente en guaraníes del monto recibido.
    montoRecibidoPyg: BigDecimal
    # Cuánto falta para cubrir el total, en la moneda recibida.
    faltante: BigDecimal!
    suficiente: Boolean!
    # Importes que el cliente suele entregar, en la moneda recibida; el primero es el exacto.
    montosSugeridos: [BigDecimal!]!

    # ---- Lo que devuelve el cajero ----
    monedaVuelto: String!
    # Guaraníes por unidad de la moneda del vuelto. Null cuando es PYG.
    cotizacionVuelto: BigDecimal
    # Vuelto en guaraníes.
    vueltoPyg: BigDecimal!
    # Vuelto expresado en monedaVuelto.
    vuelto: BigDecimal!
    # False si la moneda del vuelto no tiene catálogo de billetes y monedas.
    desgloseDisponible: Boolean!
    desglose: [DenominacionVuelto!]!
    # Parte del vuelto (en monedaVuelto) que no se puede entregar con denominaciones en circulación.
    residuo: BigDecimal!
}

extend type Query {
    listarCotizaciones: [CotizacionOutput!]!
    listarCotizacionesActivas: [CotizacionOutput!]!
    listarCotizacionesPaginado(page: Int!, size: Int!, filter: String): CotizacionPageResponse!
    obtenerCotizacionPorId(id: ID!): CotizacionOutput
    cotizarTotal(totalPyg: BigDecimal!): [MontoCotizado!]!
    # Calcula el vuelto. monedaRecibida: en qué paga el cliente; monedaVuelto: en qué se devuelve
    # (ambas PYG por defecto). Sin montoRecibido devuelve solo las sugerencias.
    calcularVuelto(
        totalPyg: BigDecimal!,
        montoRecibido: BigDecimal,
        monedaRecibida: String,
        monedaVuelto: String
    ): VueltoOutput!
}

extend type Mutation {
    registrarCaja(input: CajaInput!): CajaOutput
    actualizarCaja(id: ID!, input: CajaInput!): CajaOutput
    eliminarCaja(id: ID!): Boolean

    registrarMaletin(input: MaletinInput!): MaletinOutput
    actualizarMaletin(id: ID!, input: MaletinInput!): MaletinOutput
    eliminarMaletin(id: ID!): Boolean

    abrirCaja(input: AbrirCajaInput!): SesionCajaOutput
    cerrarCaja(input: CerrarCajaInput!): SesionCajaOutput
    # Retiro de efectivo con la caja abierta; no puede superar lo esperado en esa moneda.
    registrarRetiroCaja(input: RetiroCajaInput!): RetiroCajaOutput!

    registrarVenta(input: VentaInput!): VentaOutput
    registrarVentaConFactura(input: VentaInput!): VentaConFacturaOutput!

    crearCotizacion(input: CotizacionInput!): CotizacionOutput
    actualizarCotizacion(id: ID!, input: CotizacionInput!): CotizacionOutput
    eliminarCotizacion(id: ID!): Boolean
}

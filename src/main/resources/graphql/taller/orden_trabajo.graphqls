# =============================================================
# Schema de Orden de Trabajo - CRUD + flujo de etapas (piezas anidadas)
# =============================================================

type OrdenRecepcionOutput {
    descripcion_falla: String
}

type OrdenEstadoVehiculoOutput {
    falla_mecanica: Boolean
    falla_electrica: Boolean
    estado_llantas: Boolean
    estado_pintura: Boolean
    estado_rayones: Boolean
    estado_golpes: Boolean
    estado_vidrios: Boolean
    perdida_aceite: Boolean
    luces_danadas: Boolean
    espejos_danados: Boolean
    accesorios_faltantes: Boolean
    nivel_combustible: String
    kilometraje: Int
    observaciones_estado: String
}

type OrdenDiagnosticoHallazgoOutput {
    id_hallazgo: ID
    tipo: String
    gravedad: String
    sistema: String
    descripcion: String
    etapa_origen: String
}

type OrdenDiagnosticoOutput {
    fecha_inicio_estimada: String
    fecha_fin_estimada: String
    duracion_estimada_dias: Int
    presupuesto_aprobado: Boolean
    total_presupuesto: BigDecimal
    observaciones: String
}

type OrdenTrabajoOutput {
    id_orden_trabajo: ID
    numero_orden: String
    etapa: String
    cliente: ClienteOutput
    vehiculo: VehiculoOutput
    mecanico: FuncionarioOutput
    sector: SectorOutput
    responsable: UsuarioOutput
    fecha_creacion: String
    fecha_finalizacion: String
    caja: CajaOutput
    recepcion: OrdenRecepcionOutput
    estado_vehiculo: OrdenEstadoVehiculoOutput
    diagnostico: OrdenDiagnosticoOutput
    detalles: [OrdenTrabajoDetalleOutput]
    hallazgos: [OrdenDiagnosticoHallazgoOutput]
}

type OrdenTrabajoDetalleOutput {
    id_detalle: ID
    tipo: String
    id_producto: ID
    nombre_producto: String
    id_servicio: ID
    nombre_servicio: String
    descripcion: String
    cantidad: BigDecimal
    precio_unitario: BigDecimal
    subtotal: BigDecimal
    etapa_origen: String
}

type OrdenTrabajoPageResponse {
    content: [OrdenTrabajoOutput!]!
    pageInfo: PageInfo!
}

input OrdenRecepcionInput {
    descripcion_falla: String
}

input OrdenEstadoVehiculoInput {
    falla_mecanica: Boolean
    falla_electrica: Boolean
    estado_llantas: Boolean
    estado_pintura: Boolean
    estado_rayones: Boolean
    estado_golpes: Boolean
    estado_vidrios: Boolean
    perdida_aceite: Boolean
    luces_danadas: Boolean
    espejos_danados: Boolean
    accesorios_faltantes: Boolean
    nivel_combustible: String
    kilometraje: Int
    observaciones_estado: String
}

input OrdenDiagnosticoInput {
    fecha_inicio_estimada: String
    fecha_fin_estimada: String
    duracion_estimada_dias: Int
    presupuesto_aprobado: Boolean
    observaciones: String
}

input OrdenDiagnosticoHallazgoInput {
    tipo: String!
    gravedad: String
    sistema: String
    descripcion: String!
}

input OrdenTrabajoInput {
    id_sector: ID
    id_responsable: ID
    id_cliente: ID
    id_vehiculo: ID
    id_mecanico: ID
    id_caja: ID
    recepcion: OrdenRecepcionInput
    estado_vehiculo: OrdenEstadoVehiculoInput
    diagnostico: OrdenDiagnosticoInput
}

input OrdenTrabajoDetalleInput {
    tipo: String!
    id_producto: ID
    id_servicio: ID
    descripcion: String
    cantidad: BigDecimal
    precio_unitario: BigDecimal
}

extend type Mutation {
    crearOrdenTrabajo(input: OrdenTrabajoInput!): OrdenTrabajoOutput
    actualizarOrdenTrabajo(id: ID!, input: OrdenTrabajoInput!): OrdenTrabajoOutput
    cambiarEtapaOrdenTrabajo(id: ID!, etapa: String!): OrdenTrabajoOutput
    agregarDetalleOrdenTrabajo(idOrden: ID!, input: OrdenTrabajoDetalleInput!): OrdenTrabajoOutput
    eliminarDetalleOrdenTrabajo(idOrden: ID!, idDetalle: ID!): OrdenTrabajoOutput
    agregarHallazgoOrdenTrabajo(idOrden: ID!, input: OrdenDiagnosticoHallazgoInput!): OrdenTrabajoOutput
    eliminarHallazgoOrdenTrabajo(idOrden: ID!, idHallazgo: ID!): OrdenTrabajoOutput
    enviarOrdenACaja(idOrden: ID!, idCaja: ID!): OrdenTrabajoOutput
    marcarOrdenFacturada(idOrden: ID!): OrdenTrabajoOutput
    eliminarOrdenTrabajo(id: ID!): Boolean
}

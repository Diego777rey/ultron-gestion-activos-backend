# =============================================================
# Consulta de RUC - datos públicos de la DNIT (vía TuRuc)
# =============================================================

type ContribuyenteRucOutput {
    ruc: String
    documento: String
    dv: Int
    razonSocial: String
    nombre: String
    estado: String
    activo: Boolean!
    personaJuridica: Boolean!
    entidadPublica: Boolean!
}

extend type Query {
    # Devuelve null si el RUC no figura en la DNIT.
    consultarRuc(ruc: String!): ContribuyenteRucOutput
}
